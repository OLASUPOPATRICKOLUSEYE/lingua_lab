{
  "name": "lingua_lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "classroom": "./scripts/dev-classroom.sh",
    "classroom:ai": "./scripts/dev-classroom.sh --ai",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https --experimental-https-key certificates/lan-key.pem --experimental-https-cert certificates/lan.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:app": "vitest run",
    "worker:grading": "tsx server/workers/grading-worker.ts",
    "worker:normalization": "tsx server/workers/normalization-worker.ts",
    "ai:smoke": "tsx server/ai/smoke.ts",
    "db:generate": "pnpm --filter @lingua/db db:generate",
    "db:push": "pnpm --filter @lingua/db db:push",
    "db:migrate": "pnpm --filter @lingua/db db:migrate",
    "rls:apply": "pnpm --filter @lingua/db rls:apply",
    "db:seed": "pnpm --filter @lingua/db db:seed",
    "test": "pnpm --filter @lingua/db test",
    "test:rls": "pnpm --filter @lingua/db test:rls"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@lingua/db": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.61.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
